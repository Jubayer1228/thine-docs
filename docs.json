              "en/how-it-works"
            ]
          },
          {
            "group": "Thine Runtime",
            "pages": [
              "en/runtime/gateway",
              "en/runtime/configuration",
              "en/runtime/middleware",
              "en/runtime/dashboard"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "en/providers",
              "en/memory",
              "en/permission-modes",
              "en/prompt-caching"
            ]
          }
        ]
      },
      {
        "tab": "Build with Thine",
        "groups": [
          {
            "group": "Agents and parallel work",
            "pages": [
              "en/agents",
              "en/subagents",
              "en/goal"
            ]
          },
          {
            "group": "MCP",
            "pages": [
              "en/mcp",
              "en/mcp-quickstart"
            ]
          },
          {
            "group": "Skills and plugins",
            "pages": [
              "en/skills",
              "en/plugins"
            ]
          },
          {
            "group": "Hooks",
            "pages": [
              "en/hooks-guide",
              "en/hooks"
            ]
          }
        ]
      },
      {
        "tab": "Configuration",
        "groups": [
          {
            "group": "Settings and permissions",
            "pages": [
              "en/settings",
              "en/permissions"
            ]
          },
          {
            "group": "Model and responses",
            "pages": [
              "en/model-config"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "en/cli-reference",
              "en/env-vars",
              "en/tools-reference"
            ]
          },
          {
            "group": "Glossary",
            "pages": [
              "en/glossary"
            ]
          }
        ]
      },
      {
        "tab": "Thine Agent SDK",
        "groups": [
          {
            "group": "Thine Agent SDK",
            "pages": [
              "en/agent-sdk/overview",
              "en/agent-sdk/quickstart",
              "en/agent-sdk/sessions"
