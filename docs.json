{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Thine Docs",
  "theme": "mint",
  "colors": {
    "primary": "#0D9488",
    "light": "#14B8A6",
    "dark": "#0F766E"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Download Mac",
        "href": "https://storage.googleapis.com/robinailabs-dist/desktop/stable/Thine-darwin-x64.zip"
      },
      {
        "label": "thine.ai",
        "href": "https://thine.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/en/platforms"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Getting started",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "en/overview",
              "en/platforms",
              "en/quickstart",
